{
  "manifest_version": 3,
  "name": "Leon's Banner Builder",
  "version": "1.0.0",
  "description": "AI-powered banner generator for Leon's — upload flyer + reference, get animated banner automatically.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Leon's Banner Builder"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["chatgpt.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "downloads",
    "activeTab"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["animator/animator.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
